{
  "manifest_version": 3,
  "name": "Kids A-Z 答案助手",
  "version": "1.6",
  "description": "Kids A-Z 答案助手：测验答案、页面高亮、学生自动登录、一键完成与书籍下载。",
  "homepage_url": "https://github.com/YFY0109/KidsAZAns",
  "permissions": ["storage", "activeTab", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://www.kidsa-z.com/*",
    "*://mi.content.kidsa-z.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://www.kidsa-z.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.kidsa-z.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.kidsa-z.com/*"],
      "js": ["auto-login.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.kidsa-z.com/*"],
      "js": ["auto-complete.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.kidsa-z.com/*"],
      "js": ["download.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kids A-Z 答案助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
